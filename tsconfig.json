{
  // Type checking only — see ARCHITECTURE.md section 0. `noEmit` is the point: nothing here
  // compiles, transpiles or bundles, so `src/` stays plain ES modules that a browser loads
  // straight from a static server. TypeScript is a linter for the JSDoc we already write.
  //
  // `include` starts at the layers where a type error is most expensive and the code is most
  // stable: `engine/` (the fixed-timestep loop and deterministic math) and `net/` (lockstep,
  // where a contract mismatch desyncs a match rather than throwing). Widen it a directory at a
  // time — `npm run typecheck` must stay green, so a directory joins only once it is clean.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],

    // Deliberately off. The codebase is untyped JS with sparse JSDoc; strict mode reports
    // thousands of "implicitly any" findings that say nothing about correctness. What is on
    // below are the checks that catch real mistakes without demanding annotations first.
    "strict": false,
    "noImplicitAny": false,

    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "types/**/*.d.ts",
    "src/engine/**/*.js",
    "src/net/**/*.js"
  ]
}
