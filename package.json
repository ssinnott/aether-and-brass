{
  "name": "aether-and-brass",
  "version": "0.1.0",
  "description": "Steampunk high-fantasy side-scrolling beat-em-up (Golden Axe / TMNT style) in vanilla JS + Canvas",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node tools/server.js",
    "build": "node tools/build.js",
    "test": "node tools/simtest.js && node tools/playtest.js",
    "simtest": "node tools/simtest.js",
    "winrate": "node tools/winrate.js",
    "art-check": "node tools/art-check.js",
    "art-selftest": "node tools/art-invariants/selftest.js",
    "check": "npm run typecheck && npm run simtest && npm run nettest && npm run art-check && npm run art-selftest",
    "check:browser": "node tools/playtest.js",
    "lint": "node --check src/main.js && npm run typecheck",
    "typecheck": "tsc -p tsconfig.json",
    "nettest": "node tools/nettest.js"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3"
  }
}
